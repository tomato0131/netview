[Unit]
Description=NetView Network Management Platform
After=network.target mariadb.service

[Service]
Type=simple
WorkingDirectory=/data/net_view
ExecStart=/usr/bin/python /data/net_view/serve_api.py
Restart=always
RestartSec=5
Environment=NETVIEW_HOME=/data/net_view
Environment=NETVIEW_MYSQL_HOST=localhost
Environment=NETVIEW_MYSQL_USER=netview
Environment=NETVIEW_MYSQL_PASS=changeme
Environment=NETVIEW_MYSQL_DB=netview

[Install]
WantedBy=multi-user.target
